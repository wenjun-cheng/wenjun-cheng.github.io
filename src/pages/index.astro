  {
    title: "RACCOON",
    subtitle: "Independent project",
    body: "Research-as-code: search, take notes, and conduct deep analysis in the IDE, organizing information as files.",
    href: "https://github.com/wenjun-cheng/RACCOON",
  },
  {
    title: "TEG-SLAM",
    subtitle: "Course project · University of Michigan",
    body: "Temporal Evidence Guided monocular Gaussian SLAM with memory-aware uncertainty filtering for robust tracking in dynamic scenes.",
    href: "https://github.com/chloeqxq/Rob530-Group20-TEG-SLAM",
  },
];

const activities = [
  "Founding President, SJTU Global College Tennis Association (08/2024 – 08/2025) — founded the college's first tennis club, grew it to 100+ registered members, and coordinated 10+ intra- and inter-institute competitions.",
  "Campus Concert Performer & Event Organizer, SJTU Student Union — coordinated concert logistics and performed piano and clarinet on stage.",
  "Campus Ambassador, SJTU Global College — admissions outreach and ongoing Q&A for prospective students.",
  "Shenzhen X-Institute & Tsien Hsue-shen Elite Class in Mechanics — led two independent STEM projects, receiving the Best Design Award and Most Valuable Research Award; selected as a distinguished \"Zero-One Student\".",
];

const nav = [
  { href: "#about", label: "About" },
  { href: "#education", label: "Education" },
  { href: "#publication", label: "Publication" },
  { href: "#research", label: "Research" },
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
  { href: "#activities", label: "Activities" },
];
---

<Base>
  <div class="layout">
    <aside class="sidebar">
      <img class="portrait" src={identity.portrait} alt="Portrait of Wenjun Cheng" width="160" height="160" />
      <h1>{identity.name}</h1>
      {identity.taglines.map((t) => <p class="tagline">{t}</p>)}
      <nav class="site-nav">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <div class="contact">
        <a href={`mailto:${identity.email}`}>{identity.email}</a>
        <a href={identity.github} target="_blank" rel="noopener">GitHub</a>
        <span>{identity.location}</span>
      </div>
      <p class="copyright">© {new Date().getFullYear()} Wenjun Cheng</p>
    </aside>

    <main class="content">
    <section id="about">
      <h2>About</h2>
      {about.map((p) => <p class="about">{p}</p>)}
    </section>

    <section id="education">
      <h2>Education</h2>
      {education.map((e) => (
        <article class="entry">
          <div class="entry-head">
            <h3>{e.school}</h3>
            <span class="period">{e.period}</span>
          </div>
          <p class="meta">{e.degree}</p>
          <ul>{e.notes.map((n) => <li>{n}</li>)}</ul>
        </article>
      ))}
    </section>

    <section id="publication">
      <h2>Publication</h2>
      {publications.map((p) => (
        <article class="entry">
          <p class="pub-title">{p.title}</p>
          <p class="meta" set:html={p.authors} />
          {p.venues.map((v) => <p class="meta venue">{v}</p>)}
        </article>
      ))}
    </section>

    <section id="research">
      <h2>Research Experience</h2>
      {research.map((r) => (
        <details class="entry">
          <summary>
            <span class="entry-head">
              <span class="entry-title">{r.title}</span>
              <span class="period">{r.period}</span>
            </span>
            <span class="meta">{r.meta}</span>
          </summary>
          <ul>{r.points.map((pt) => <li>{pt}</li>)}</ul>
        </details>
      ))}
    </section>

    <section id="experience">
      <h2>Professional &amp; Teaching Experience</h2>
      {experience.map((e) => (
        <article class="entry">
          <div class="entry-head">
            <h3>{e.title}</h3>
            <span class="period">{e.period}</span>
          </div>
          <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>
        </article>
      ))}
    </section>

    <section id="projects">
      <h2>Projects</h2>
      {projects.map((p) => (
        <article class="entry">
          <div class="entry-head">
            <h3>{p.href ? <a href={p.href} target="_blank" rel="noopener">{p.title}</a> : p.title}</h3>
          </div>
          <p class="meta">{p.subtitle}</p>
          <p class="body">{p.body}</p>
        </article>
      ))}
    </section>

    <section id="activities">
      <h2>Leadership &amp; Activities</h2>
      <ul class="plain-list">{activities.map((a) => <li>{a}</li>)}</ul>
    </section>

    <footer>
      <p>
        Beyond research: piano (Grade 8, Royal Academy of Music), clarinet (Level 9, Central
        Conservatory of Music), and tennis.
      </p>
    </footer>
    </main>
  </div>
</Base>
