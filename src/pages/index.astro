---
import Base from "../layouts/Base.astro";

const identity = {
  name: "Wenjun Cheng",
  taglines: ["Robotics @ University of Michigan", "ECE @ Shanghai Jiao Tong University"],
  email: "wjchengx@umich.edu",
  github: "https://github.com/wenjun-cheng",
  location: "Ann Arbor, MI",
  portrait: "/portrait.jpg",
};

const about = [
  "I build spatial AI systems for robots. My research focuses on multi-robot systems and vision-and-language navigation (VLN).",
  "I am currently an undergraduate researcher at the University of Michigan's Scalable Spatial Intelligence (SSI) Lab and the Computational Autonomy and Robotics Laboratory (CURLY).",
];

const education = [
  {
    logo: "/logos/umich.png",
    school: "University of Michigan",
    degree: "B.S.E. in Robotics · GPA 4.0/4.0",
    period: "08/2025 – 05/2027 (expected)",
    notes: [
      "Graduate coursework: Foundation of Language Models (A), Mobile Robotics (A+), Multi-Robot Systems (A), Self-Driving Cars (Fall 2026)",
      "University Honors · Dean's List · Michigan Engineering Continuing Student Scholarship",
    ],
  },
  {
    logo: "/logos/sjtu.png",
    school: "Shanghai Jiao Tong University",
    degree: "B.S.E. in Electrical and Computer Engineering · GPA 3.65/4.0",
    period: "08/2023 – 08/2027 (expected)",
    notes: [
      "Huatai Securities Technology Scholarship · Yu Liming Scholarship · Outstanding Undergraduate Scholarship",
    ],
  },
];

const publications = [
  {
    title:
      "HeRo-Nav: Heterogeneous Multi-Robot Collaboration for Semantic Navigation with Vision Language Models",
    authors: "Siddhant Tandon*, <strong>Wenjun Cheng*</strong>, Junzhe Wu, Yue Hu, Yulun Tian",
    venues: [
      "RSS 2026 Workshop on Open World Navigation in the Foundation Model Era: Robustness and Failure Recovery",
      "RSS 2026 Workshop on Robot Planning in the Era of Foundation Models (FM4RoboPlan)",
    ],
  },
];

const research = [
  {
    title: "Uncertainty-Aware Decentralized Multi-Robot Object Search",
    meta: "Undergraduate RA · Prof. Yulun Tian & Prof. Vasileios Tzoumas, University of Michigan",
    period: "06/2026 – Present",
    points: [
      "Leading construction of simulation environments and evaluation scenarios for decentralized multi-robot exploration with heterogeneous robot teams.",
      "Refactoring HeRo-Nav navigation modules (RGB-D occupancy mapping, frontier extraction, local planning) into a decentralized architecture with pose, task, frontier, and compact semantic message exchange.",
      "Benchmarking against centralized and communication-free baselines (ongoing).",
    ],
  },
  {
    title: "HeRo-Nav: Heterogeneous Multi-Robot Semantic Navigation with VLMs",
    meta: "Undergraduate RA & co-first author · Prof. Yulun Tian & Dr. Yue Hu, University of Michigan",
    period: "02/2026 – Present",
    points: [
      "Zero-shot semantic navigation framework coordinating a quadruped, a humanoid, and a drone in NVIDIA Isaac Sim disaster-response environments.",
      "Co-developed RGB-D to bird's-eye-view mapping (per-class occupancy maps, map fusion, persistent frontier identification) and the VLM coordinator's multimodal prompt and structured output interface.",
      "Achieved a 93.3% success rate (vs. 86.7% for the top classic baseline) and reduced team hazard exposure from 40.1% to 25.7%; accepted at two RSS workshops, extending the benchmark for ICRA.",
    ],
  },
  {
    title: "Probing Self-Motion Grounding in Vision-Language Models",
    meta: "Undergraduate RA & project lead · Prof. Yulun Tian & Dr. Yue Hu, University of Michigan",
    period: "01/2026 – Present",
    points: [
      "Designed an experimental paradigm to analyze how VLMs encode camera self-motion and how navigation post-training reshapes spatial representations.",
      "Built an Isaac Sim pipeline for a controlled inverse-dynamics dataset with scene-held-out evaluation, and a single-pass pipeline extracting hidden representations across Qwen3-VL's vision encoder and language model.",
      "Probing representations via semantic motion classification, Lie-algebra continuous regression, and decision analysis with careful confound controls; comparing base, SFT, and RL-navigated variants (ongoing).",
    ],
  },
  {
    title: "Structured Spatial Memory and World Modeling for VLN",
    meta: "Undergraduate RA · Prof. Maani Ghaffari & Dr. Yue Hu, University of Michigan",
    period: "10/2025 – 02/2026",
    points: [
      "Helped build a VLM-based long-horizon vision-and-language navigation framework with scene graph construction and structured semantic memory.",
      "Failure-mode analysis showed semantic memory alone cannot resolve multi-view spatial ambiguity, pinpointing weak VLM motion grounding — the inspiration for the self-motion probing project.",
    ],
  },
  {
    title: "Multimodal Platform for Liquid-Impact and Fluid–Structure Interaction",
    meta: "Undergraduate RA & project leader · Prof. David L.S. Hung, Shanghai Jiao Tong University",
    period: "04/2024 – 08/2025",
    points: [
      "Led the design and iterative optimization of a modular liquid-impact experimental platform, adopted by the lab as standard infrastructure.",
      "Built a synchronized multimodal acquisition pipeline combining piezoelectric force sensing and high-speed imaging via an infrared triggering circuit; separated genuine impact signals from structural vibration through FFT-based analysis.",
    ],
  },
  {
    title: "Edge-Aware Active Perception and Exploration Planning for UAVs",
    meta: "Research Intern · Tsinghua University Shenzhen International Graduate School",
    period: "12/2023 – 02/2024",
    points: [
      "Analyzed bottlenecks of edge-deployed active perception and assisted in developing a hybrid exploration algorithm balancing exploration efficacy and computational cost.",
      "Supported sim-to-real transfer and validation on physical UAV platforms.",
    ],
  },
];

const experience = [
  {
    title: "Edan Instruments, Inc. — Algorithm Intern, R&D System Department",
    period: "01/2025",
    points: [
      "Prototyped the company's first interactive 3D heart visualization system for ECG diagnostics, mapping diagnostic labels to anatomical regions with customized rendering, highlighting, and annotation; secured management approval for production integration.",
    ],
  },
  {
    title: "SJTU Global College — Tech TA, ENGR1000J Introduction to Engineering",
    period: "09/2024 – 12/2024",
    points: [
      "Mentored ~40 freshman engineers through the full mechatronics design lifecycle with hands-on instruction in C++, SolidWorks, and Arduino; nominated for the Annual Outstanding TA Award.",
    ],
  },
];

const projects = [
  {
    title: "RACCOON",
    subtitle: "Independent project",
    body: "Research-as-code: search, take notes, and conduct deep analysis in the IDE, organizing information as files.",
    href: "https://github.com/wenjun-cheng/RACCOON",
  },
  {
    title: "TEG-SLAM",
    subtitle: "Course project · University of Michigan",
    body: "Temporal Evidence Guided monocular Gaussian SLAM with memory-aware uncertainty filtering for robust tracking in dynamic scenes.",
    href: "https://github.com/chloeqxq/Rob530-Group20-TEG-SLAM",
  },
];

const activities = [
  {
    title: "SJTU Global College Tennis Association — Founding President",
    period: "08/2024 – 08/2025",
    points: [
      "Founded the college's first tennis club, drafting official bylaws and hosting committee elections.",
      "Grew the club to 100+ registered members and coordinated 10+ intra- and inter-institute competitions.",
    ],
  },
  {
    title: "SJTU Student Union — Concert Performer & Event Organizer",
    points: [
      "Coordinated concert arrangements: performer scheduling, onstage sequences, stage lighting and display systems.",
      "Performed as a piano and clarinet instrumentalist in campus concerts.",
    ],
  },
  {
    title: "SJTU Global College — Campus Ambassador",
    points: [
      "Designed promotional posters and organized on-site recruitment booths at alma mater.",
      "Provided ongoing online Q&A to assist prospective students.",
    ],
  },
  {
    title: "Shenzhen X-Institute & Tsien Hsue-shen Elite Class in Mechanics",
    points: [
      "Led two independent STEM projects, receiving the Best Design Award and Most Valuable Research Award; selected as a distinguished \"Zero-One Student\".",
      "Attended academic visits and technical exchanges at national research centers, including the National Center for Protein Science and the National Astronaut Training Center.",
    ],
  },
];

const nav = [
  { href: "#about", label: "About" },
  { href: "#education", label: "Education" },
  { href: "#publication", label: "Publication" },
  { href: "#research", label: "Research" },
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
  { href: "#activities", label: "Activities" },
];
---

<Base>
  <div class="layout">
    <aside class="sidebar">
      <img class="portrait" src={identity.portrait} alt="Portrait of Wenjun Cheng" width="160" height="160" />
      <h1>{identity.name}</h1>
      {identity.taglines.map((t) => <p class="tagline">{t}</p>)}
      <nav class="site-nav">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <div class="contact">
        <a href={`mailto:${identity.email}`}>{identity.email}</a>
        <a href={identity.github} target="_blank" rel="noopener">GitHub</a>
        <span>{identity.location}</span>
      </div>
      <p class="copyright">© {new Date().getFullYear()} Wenjun Cheng</p>
    </aside>

    <main class="content">
    <section id="about">
      <h2>About</h2>
      {about.map((p) => <p class="about">{p}</p>)}
    </section>

    <section id="education">
      <h2>Education</h2>
      {education.map((e) => (
        <article class="entry edu">
          <img class="school-logo" src={e.logo} alt={`${e.school} seal`} width="48" height="48" />
          <div class="edu-body">
            <div class="entry-head">
              <h3>{e.school}</h3>
              <span class="period">{e.period}</span>
            </div>
            <p class="meta">{e.degree}</p>
            <ul>{e.notes.map((n) => <li>{n}</li>)}</ul>
          </div>
        </article>
      ))}
    </section>

    <section id="publication">
      <h2>Publication</h2>
      {publications.map((p) => (
        <article class="entry">
          <p class="pub-title">{p.title}</p>
          <p class="meta" set:html={p.authors} />
          {p.venues.map((v) => <p class="meta venue">{v}</p>)}
        </article>
      ))}
    </section>

    <section id="research">
      <h2>Research Experience</h2>
      {research.map((r) => (
        <details class="entry">
          <summary>
            <span class="entry-head">
              <span class="entry-title">{r.title}</span>
              <span class="period">{r.period}</span>
            </span>
            <span class="meta">{r.meta}</span>
          </summary>
          <ul>{r.points.map((pt) => <li>{pt}</li>)}</ul>
        </details>
      ))}
    </section>

    <section id="experience">
      <h2>Experience</h2>
      {experience.map((e) => (
        <details class="entry">
          <summary>
            <span class="entry-head">
              <span class="entry-title">{e.title}</span>
              <span class="period">{e.period}</span>
            </span>
          </summary>
          <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>
        </details>
      ))}
    </section>

    <section id="projects">
      <h2>Projects</h2>
      {projects.map((p) => (
        <details class="entry">
          <summary>
            <span class="entry-head">
              <span class="entry-title">{p.title}</span>
            </span>
            <span class="meta">{p.subtitle}</span>
          </summary>
          <p class="body">
            {p.body}
            {p.href && <> <a href={p.href} target="_blank" rel="noopener">GitHub ↗</a></>}
          </p>
        </details>
      ))}
    </section>

    <section id="activities">
      <h2>Activities</h2>
      {activities.map((a) => (
        <details class="entry">
          <summary>
            <span class="entry-head">
              <span class="entry-title">{a.title}</span>
              {a.period && <span class="period">{a.period}</span>}
            </span>
          </summary>
          <ul>{a.points.map((pt) => <li>{pt}</li>)}</ul>
        </details>
      ))}
    </section>

    <footer>
      <p>
        Beyond research: piano (Grade 8, Royal Academy of Music), clarinet (Level 9, Central
        Conservatory of Music), and tennis.
      </p>
    </footer>
    </main>
  </div>
</Base>
