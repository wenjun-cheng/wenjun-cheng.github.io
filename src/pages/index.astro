---
import Base from "../layouts/Base.astro";

const identity = {
  name: "Wenjun Cheng",
  email: "wjchengx@umich.edu",
  github: "https://github.com/wenjun-cheng",
  portrait: "/portrait.jpg",
};

const bio = [
  "I am a senior in Robotics at the University of Michigan, working with Prof. Yulun Tian, Prof. Maani Ghaffari, Dr. Yue Hu, and Prof. Vasileios Tzoumas in the SSI Lab and CURLY. I am applying to graduate programs for Fall 2027.",
];

const interests = [
  "Spatial Intelligence",
  "Embodied Foundation Models",
  "Long-Horizon Memory",
  "Multi-Agent Systems",
  "Interpretability",
];

const publications = [
  {
    title:
      "HeRo-Nav: Heterogeneous Multi-Robot Collaboration for Semantic Navigation with Vision Language Models",
    authors: "Siddhant Tandon*, <strong>Wenjun Cheng*</strong>, Junzhe Wu, Yue Hu†, Yulun Tian†",
    venue:
      "RSS 2026 Workshops: Open World Navigation in the Foundation Model Era; Robot Planning in the Era of Foundation Models",
  },
];

const research = [
  {
    title: "Heterogeneous Multi-Robot Collaboration with Vision-Language Models",
    role: "Co-first author",
    advisors: "Prof. Yulun Tian, Dr. Yue Hu",
    period: "02/2026 – now",
    points: [
      "Built a system for heterogeneous multi-robot search in self-built Isaac Sim disaster scenes, in which a zero-shot VLM coordinator reasons over each robot's camera height, speed, and terrain-dependent motion cost to assign tasks from a shared spatial map fused across the team. Accepted to two RSS 2026 workshops.",
      "Extending the project into a benchmark of interdependent long-horizon missions, such as a humanoid opening a door to retrieve a medical kit and loading it onto a quadruped that delivers it through rough terrain. Built its embodiment layer with GEAR-SONIC on the Unitree G1 and an Extreme Parkour policy adapted to the Go2 with a redesigned terrain curriculum.",
      "Building an agentic baseline in which each robot's VLM agent acts through tool calls, maintains a spatio-temporal memory, and coordinates via a captain-led planning protocol.",
    ],
  },
  {
    title: "Probing and Training Ego-Motion Understanding in Navigation-Trained VLMs",
    role: "Project lead",
    advisors: "Prof. Yulun Tian, Dr. Yue Hu",
    period: "01/2026 – now",
    points: [
      "Asked whether navigation training teaches VLMs to estimate their own motion, comparing Qwen3-VL before and after navigation fine-tuning (LongNav-R1) with SE(3) motion probes on a controlled dataset of single-motion image pairs.",
      "Found that training sharpens the internal ego-motion estimate, even for motions the policy never takes, yet the model's answer never improves, and traced the estimate to cross-view attention. Now testing the reverse direction, whether ego-motion supervision improves navigation.",
    ],
  },
  {
    title: "Task-Conditioned Active Semantic Information Acquisition",
    role: "Research assistant",
    advisors: "Prof. Yulun Tian, Prof. Vasileios Tzoumas",
    period: "06/2026 – now",
    points: [
      "Leading the Unreal Engine simulation for a task-conditioned active perception framework, in which robots gather observations to resolve semantic hypotheses by propagating uncertainty from an object-level map belief, starting with a single robot and extending to multi-robot teams.",
    ],
  },
  {
    title: "Structured Spatial Memory for Vision-and-Language Navigation",
    role: "Research assistant",
    advisors: "Prof. Maani Ghaffari, Dr. Yue Hu",
    period: "10/2025 – 02/2026",
    points: [
      "Evaluated scene graphs and semantic memory for VLM agents in long-horizon VLN, finding that memory alone cannot resolve multi-view ambiguity and tracing the failure to weak VLM motion grounding, which motivated the ego-motion probing project.",
    ],
  },
  {
    title: "Multimodal Experimental Platform for Fluid–Structure Impact Analysis",
    role: "Project lead, Shanghai Jiao Tong University",
    advisors: "Prof. David L.S. Hung",
    period: "04/2024 – 08/2025",
    points: [
      "Designed a liquid-impact platform with vibration isolation and tunable impact speed, angle, droplet size, and liquid type.",
      "Built a synchronized multimodal acquisition pipeline coupling piezoelectric force sensing, high-speed imaging, and an infrared trigger circuit, with FFT-based analysis that separates impact signals from structural noise.",
    ],
  },
];

const education = [
  {
    logo: "/logos/umich.png",
    school: "University of Michigan",
    degree: "B.S.E. in Robotics · GPA 4.0/4.0",
    period: "08/2025 – 05/2027",
    notes: [
      "Graduate coursework: Foundation of Language Models (A), Mobile Robotics (A+), Multi-Robot Systems (A), Self-Driving Cars (in progress)",
      "University Honors · Dean's List · Michigan Engineering Continuing Student Scholarship",
    ],
  },
  {
    logo: "/logos/sjtu.png",
    school: "Shanghai Jiao Tong University",
    degree: "B.S.E. in Electrical and Computer Engineering",
    period: "08/2023 – 08/2027",
    notes: ["Huatai Securities Technology Scholarship · Yu Liming Scholarship · Outstanding Undergraduate Scholarship"],
  },
];

const experience = [
  {
    org: "Edan Instruments, Inc.",
    role: "Algorithm Intern, R&D System Department",
    period: "01/2025",
    text: "Prototyped the company's first interactive 3D heart visualization for ECG diagnoses, mapping diagnostic labels to cardiac regions on an adapted Blender model. Approved for production integration.",
  },
  {
    org: "SJTU Global College",
    role: "Teaching Assistant, ENGR1000J Introduction to Engineering",
    period: "09/2024 – 12/2024",
    text: "Co-designed a track race challenge for ultrasonic-guided robotic cars and mentored about 40 freshmen through it and a follow-up open-ended build, teaching C++, SolidWorks, and Arduino. Nominated for the Annual Outstanding TA Award.",
  },
  {
    org: "SJTU Global College Tennis Association",
    role: "Founding President",
    period: "08/2024 – 08/2025",
    text: "Founded the institute's tennis club, growing it to 100+ members and organizing 10+ intra- and inter-institute competitions.",
  },
];

// 24x24 stroke icons
const hobbies = [
  {
    name: "Piano",
    detail: "Grade 8, Royal Academy of Music",
    icon: '<rect x="3" y="4" width="18" height="16" rx="1.5"/><path d="M8 4v16M13 4v16M18 4v16"/><path d="M6.5 4v8M11.5 4v8M16 4v8" stroke-width="3"/>',
  },
  {
    name: "Clarinet",
    detail: "Level 9, Central Conservatory of Music",
    icon: '<path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>',
  },
  {
    name: "Tennis",
    detail: "Founding president of a 100+ member club",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M5.6 5.6a9 9 0 0 1 0 12.8M18.4 5.6a9 9 0 0 0 0 12.8"/>',
  },
  {
    name: "Soccer",
    detail: "",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5l3.3 2.4-1.3 3.9h-4l-1.3-3.9z"/><path d="M12 3v4.5M15.3 9.9l4.6-1.5M14 13.8l2.8 3.9M10 13.8l-2.8 3.9M8.7 9.9L4.1 8.4"/>',
  },
];

const links = [
  { label: identity.email, href: `mailto:${identity.email}`, icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>' },
  { label: "GitHub", href: identity.github, icon: '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>' },
];

const updated = "September 2026";
---

<Base>
  <main class="page">
    <header class="hero">
      <img class="portrait" src={identity.portrait} alt="Portrait of Wenjun Cheng" width="144" height="144" />
      <div class="hero-text">
        <h1>{identity.name}</h1>
        {bio.map((p) => <p class="bio">{p}</p>)}
        <ul class="tags" aria-label="Research interests">
          {interests.map((t) => <li>{t}</li>)}
        </ul>
        <nav class="links" aria-label="Contact and profiles">
          {links.map((l) => (
            <a href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={l.icon} />
              {l.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <section>
      <h2>Education</h2>
      {education.map((e) => (
        <article class="school">
          <img src={e.logo} alt="" width="44" height="44" />
          <div>
            <div class="row">
              <h3>{e.school}</h3>
              <span class="when">{e.period}</span>
            </div>
            <p class="meta">{e.degree}</p>
            {e.notes.map((n) => <p class="small">{n}</p>)}
          </div>
        </article>
      ))}
    </section>

    <section>
      <h2>Research</h2>
      <div class="timeline">
        {research.map((r) => (
          <article class="item">
            <p class="when">{r.period}</p>
            <div>
              <h3>{r.title}</h3>
              <p class="meta">{r.role} · Advisors: {r.advisors}</p>
              <ul>{r.points.map((pt) => <li>{pt}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section>
      <h2>Publication</h2>
      {publications.map((p) => (
        <article class="pub">
          <p class="pub-title">{p.title}</p>
          <p class="meta" set:html={p.authors} />
          <p class="meta venue">{p.venue}</p>
        </article>
      ))}
      <p class="note">* equal contribution · † corresponding author</p>
    </section>

    <section>
      <h2>Experience</h2>
      <div class="timeline">
        {experience.map((x) => (
          <article class="item">
            <p class="when">{x.period}</p>
            <div>
              <h3>{x.org}</h3>
              <p class="meta">{x.role}</p>
              <p class="small">{x.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section>
      <h2>Beyond Research</h2>
      <ul class="hobbies">
        {hobbies.map((h) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={h.icon} />
            <span><strong>{h.name}</strong>{h.detail && <span class="small">{h.detail}</span>}</span>
          </li>
        ))}
      </ul>
    </section>

    <footer>
      <p>© {new Date().getFullYear()} Wenjun Cheng · Last updated {updated}</p>
    </footer>
  </main>
</Base>
