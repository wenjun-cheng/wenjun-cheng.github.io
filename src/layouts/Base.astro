---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Wenjun Cheng",
  description = "Robotics @ Michigan & SJTU — multi-robot perception, VLN, and embodied AI.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://wenjun-cheng.github.io/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://wenjun-cheng.github.io/" />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
